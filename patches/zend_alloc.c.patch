diff --git a/Zend/tests/zos_aligned_chunks.phpt b/Zend/tests/zos_aligned_chunks.phpt
new file mode 100644
index 00000000..321deb4a
--- /dev/null
+++ b/Zend/tests/zos_aligned_chunks.phpt
@@ -0,0 +1,30 @@
+--TEST--
+Zend MM large aligned chunks retain data across grow, shrink and free
+--INI--
+memory_limit=64M
+--SKIPIF--
+<?php
+if (getenv('USE_ZEND_ALLOC') === '0') die('skip Zend MM is explicitly disabled');
+?>
+--FILE--
+<?php
+var_dump(memory_get_usage(true) > 0);
+for ($i = 0; $i < 20; $i++) {
+    $s = str_repeat('A', 3 * 1024 * 1024);
+    $s .= str_repeat('B', 4 * 1024 * 1024);
+    if (strlen($s) !== 7 * 1024 * 1024 || $s[0] !== 'A'
+        || $s[strlen($s) - 1] !== 'B') {
+        throw new Exception('Large allocation contents changed');
+    }
+    $s = substr($s, 0, 1024);
+    if ($s !== str_repeat('A', 1024)) {
+        throw new Exception('Shrink changed data');
+    }
+    unset($s);
+    gc_mem_caches();
+}
+echo "grow/shrink/free passed\n";
+?>
+--EXPECT--
+bool(true)
+grow/shrink/free passed
