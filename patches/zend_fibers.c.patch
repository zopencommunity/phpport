diff --git a/Zend/zend_fibers.c b/Zend/zend_fibers.c
index 62d58923..35f6b3e4 100644
--- a/Zend/zend_fibers.c
+++ b/Zend/zend_fibers.c
@@ -26,6 +26,9 @@
 #include "zend_builtin_functions.h"
 #include "zend_observer.h"
 #include "zend_mmap.h"
+#ifdef __MVS__
+# include <zos-base.h>
+#endif
 #include "zend_compile.h"
 #include "zend_closures.h"
 #include "zend_generators.h"
@@ -188,7 +191,14 @@ static zend_fiber_stack *zend_fiber_stack_allocate(size_t size)
 	}
 
 	const size_t stack_size = (size + page_size - 1) / page_size * page_size;
+#ifdef __MVS__
+	/* AMODE 64 makecontext needs above-bar storage and reserves a 1 MiB
+	 * guard on a 1 MiB boundary. Budget two MiB for its guard/alignment;
+	 * LE manages protection as contexts are switched. */
+	const size_t alloc_size = stack_size + 2 * 1024 * 1024;
+#else
 	const size_t alloc_size = stack_size + ZEND_FIBER_GUARD_PAGES * page_size;
+#endif
 
 #ifdef ZEND_WIN32
 	pointer = VirtualAlloc(0, alloc_size, MEM_COMMIT, PAGE_READWRITE);
@@ -213,6 +223,17 @@ static zend_fiber_stack *zend_fiber_stack_allocate(size_t size)
 		return NULL;
 	}
 # endif
+#elif defined(__MVS__)
+	pointer = __aligned_malloc(alloc_size, 1024 * 1024);
+	if (pointer == NULL) {
+		zend_throw_exception_ex(NULL, 0, "Fiber stack allocate failed: %s (%d)", strerror(errno), errno);
+		return NULL;
+	}
+	if ((uintptr_t) pointer < (uintptr_t) 0x80000000U) {
+		__aligned_free(pointer);
+		zend_throw_exception_ex(NULL, 0, "Fiber stack allocate failed: AMODE 64 requires storage above 2 GiB");
+		return NULL;
+	}
 #else
 	pointer = mmap(NULL, alloc_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_STACK, -1, 0);
 
@@ -234,8 +255,13 @@ static zend_fiber_stack *zend_fiber_stack_allocate(size_t size)
 
 	zend_fiber_stack *stack = emalloc(sizeof(zend_fiber_stack));
 
+#ifdef __MVS__
+	stack->pointer = pointer;
+	stack->size = alloc_size;
+#else
 	stack->pointer = (void *) ((uintptr_t) pointer + ZEND_FIBER_GUARD_PAGES * page_size);
 	stack->size = stack_size;
+#endif
 
 #ifdef VALGRIND_STACK_REGISTER
 	uintptr_t base = (uintptr_t) stack->pointer;
@@ -256,6 +282,9 @@ static void zend_fiber_stack_free(zend_fiber_stack *stack)
 	VALGRIND_STACK_DEREGISTER(stack->valgrind_stack_id);
 #endif
 
+#ifdef __MVS__
+	__aligned_free(stack->pointer);
+#else
 	const size_t page_size = zend_fiber_get_page_size();
 
 	void *pointer = (void *) ((uintptr_t) stack->pointer - ZEND_FIBER_GUARD_PAGES * page_size);
@@ -270,6 +299,7 @@ static void zend_fiber_stack_free(zend_fiber_stack *stack)
 	VirtualFree(pointer, 0, MEM_RELEASE);
 #else
 	munmap(pointer, stack->size + ZEND_FIBER_GUARD_PAGES * page_size);
+#endif
 #endif
 
 	efree(stack);
@@ -342,14 +372,37 @@ ZEND_API bool zend_fiber_init_context(zend_fiber_context *context, void *kind, z
 #ifdef ZEND_FIBER_UCONTEXT
 	ucontext_t *handle = &context->stack->ucontext;
 
+#ifdef __MVS__
+	if (getcontext(handle) != 0) {
+		int err = errno;
+		zend_throw_exception_ex(NULL, 0, "Fiber getcontext failed: %s (%d)", strerror(err), err);
+		zend_fiber_stack_free(context->stack);
+		context->stack = NULL;
+		return false;
+	}
+#else
 	getcontext(handle);
+#endif
 
 	handle->uc_stack.ss_size = context->stack->size;
 	handle->uc_stack.ss_sp = context->stack->pointer;
 	handle->uc_stack.ss_flags = 0;
 	handle->uc_link = NULL;
 
+#ifdef __MVS__
+	/* Unlike getcontext, makecontext reports failure only through errno. */
+	errno = 0;
+#endif
 	makecontext(handle, (void (*)(void)) zend_fiber_trampoline, 0);
+#ifdef __MVS__
+	if (errno != 0) {
+		int err = errno;
+		zend_throw_exception_ex(NULL, 0, "Fiber makecontext failed: %s (%d)", strerror(err), err);
+		zend_fiber_stack_free(context->stack);
+		context->stack = NULL;
+		return false;
+	}
+#endif
 
 	context->handle = handle;
 #else
