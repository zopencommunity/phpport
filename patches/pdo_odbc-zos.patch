diff --git a/ext/pdo_odbc/Makefile.zos.frag b/ext/pdo_odbc/Makefile.zos.frag
new file mode 100644
index 00000000..72a67fc9
--- /dev/null
+++ b/ext/pdo_odbc/Makefile.zos.frag
@@ -0,0 +1,8 @@
+# Native z/OS imports cannot be resolved with ELF-style libtool module links.
+# PHP exports its core into php.x; bind the module only after that executable.
+$(phplibdir)/pdo_odbc.so: $(shared_objects_pdo_odbc) $(SAPI_CLI_PATH) $(PDO_ODBC_SHARED_LIBADD)
+	$(CC) -shared $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS) -o $@ $(shared_objects_pdo_odbc:.lo=.o) $(top_builddir)/sapi/cli/php.x $(PDO_ODBC_SHARED_LIBADD)
+
+# PHP's test runner sources .la metadata to discover module names.
+$(phplibdir)/pdo_odbc.la: $(phplibdir)/pdo_odbc.so
+	@echo "dlname='pdo_odbc.so'" > $@
