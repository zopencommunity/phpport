@@ -525,6 +525,7 @@ static int odbc_stmt_fetch(pdo_stmt_t *stmt,
 {
 	RETCODE rc;
 	SQLSMALLINT odbcori;
+	char *fetch_api = "SQLFetchScroll";
 	pdo_odbc_stmt *S = (pdo_odbc_stmt*)stmt->driver_data;
 
 	switch (ori) {
@@ -538,13 +539,27 @@ static int odbc_stmt_fetch(pdo_stmt_t *stmt,
 			strcpy(stmt->error_code, "HY106");
 			return 0;
 	}
+#ifdef PDO_ODBC_DB2_ZOS
+	/* Native Db2 cannot reliably SQLGetData LOBs after SQLFetchScroll. */
+	if (ori == PDO_FETCH_ORI_NEXT) {
+		fetch_api = "SQLFetch";
+		rc = SQLFetch(S->stmt);
+	} else {
+		if (offset > INT32_MAX || offset < INT32_MIN) {
+			strcpy(stmt->error_code, "HY106");
+			return 0;
+		}
+		rc = SQLFetchScroll(S->stmt, odbcori, (SQLLEN)offset);
+	}
+#else
 	rc = SQLFetchScroll(S->stmt, odbcori, offset);
+#endif
 
 	if (rc == SQL_SUCCESS) {
 		return 1;
 	}
 	if (rc == SQL_SUCCESS_WITH_INFO) {
-		pdo_odbc_stmt_error("SQLFetchScroll");
+		pdo_odbc_stmt_error(fetch_api);
 		return 1;
 	}
 
@@ -553,7 +568,7 @@ static int odbc_stmt_fetch(pdo_stmt_t *stmt,
 		return 0;
 	}
 
-	pdo_odbc_stmt_error("SQLFetchScroll");
+	pdo_odbc_stmt_error(fetch_api);
 
 	return 0;
 }
