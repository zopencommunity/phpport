diff --git a/ext/pdo_odbc/odbc_zos_driver.h b/ext/pdo_odbc/odbc_zos_driver.h
new file mode 100644
index 00000000..a26ff101
--- /dev/null
+++ b/ext/pdo_odbc/odbc_zos_driver.h
@@ -0,0 +1,117 @@
+/* Native Db2 connection helpers. No PHP, CLI headers or database required. */
+#ifndef PDO_ODBC_ZOS_DRIVER_H
+#define PDO_ODBC_ZOS_DRIVER_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define PDO_ODBC_ZOS_UID 1u
+#define PDO_ODBC_ZOS_PWD 2u
+
+static inline int pdo_odbc_zos_space(unsigned char c)
+{
+	return c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\f' || c == '\v';
+}
+
+static inline unsigned char pdo_odbc_zos_upper(unsigned char c)
+{
+	return c >= 'a' && c <= 'z' ? c - ('a' - 'A') : c;
+}
+
+/* Only attribute names at the start of semicolon-delimited fields count.
+ * A brace-quoted value can contain semicolons; }} encodes a literal }.
+ * An unterminated quoted value consumes the rest (never invent a key in it). */
+static inline unsigned pdo_odbc_zos_credentials(const char *dsn)
+{
+	const char *p = dsn;
+	unsigned found = 0;
+
+	while (*p) {
+		const char *key, *end;
+		while (*p == ';' || pdo_odbc_zos_space((unsigned char)*p)) {
+			p++;
+		}
+		key = p;
+		while (*p && *p != '=' && *p != ';') {
+			p++;
+		}
+		if (*p != '=') {
+			continue;
+		}
+		end = p;
+		while (end > key && pdo_odbc_zos_space((unsigned char)end[-1])) {
+			end--;
+		}
+		if (end - key == 3) {
+			unsigned char a = pdo_odbc_zos_upper((unsigned char)key[0]);
+			unsigned char b = pdo_odbc_zos_upper((unsigned char)key[1]);
+			unsigned char c = pdo_odbc_zos_upper((unsigned char)key[2]);
+			if (a == 'U' && b == 'I' && c == 'D') {
+				found |= PDO_ODBC_ZOS_UID;
+			} else if (a == 'P' && b == 'W' && c == 'D') {
+				found |= PDO_ODBC_ZOS_PWD;
+			}
+		}
+		p++;
+		while (pdo_odbc_zos_space((unsigned char)*p)) {
+			p++;
+		}
+		if (*p == '{') {
+			p++;
+			while (*p) {
+				if (*p++ == '}') {
+					if (*p == '}') {
+						p++;
+					} else {
+						break;
+					}
+				}
+			}
+		}
+		while (*p && *p != ';') {
+			p++;
+		}
+	}
+	return found;
+}
+
+static inline int pdo_odbc_zos_sql_length_valid(size_t length)
+{
+	return length <= INT32_MAX;
+}
+
+static inline int pdo_odbc_zos_connstr_length_valid(size_t length)
+{
+	return length <= INT16_MAX;
+}
+
+/* Account for ;UID= or ;PWD= and a value, without size_t overflow. */
+static inline int pdo_odbc_zos_append_length(size_t *length, size_t value_length)
+{
+	if (!pdo_odbc_zos_connstr_length_valid(*length)
+			|| value_length > INT16_MAX - 5u
+			|| *length > INT16_MAX - 5u - value_length) {
+		return 0;
+	}
+	*length += 5u + value_length;
+	return 1;
+}
+
+/* The driver calls SQLPrepare with SQL_NTS. Reject embedded NUL instead of
+ * preparing a silently truncated query; still enforce its SQLINTEGER bound. */
+static inline int pdo_odbc_zos_prepare_text_valid(const char *sql, size_t length)
+{
+	return pdo_odbc_zos_sql_length_valid(length) && memchr(sql, '\0', length) == NULL;
+}
+
+/* CLI reports the full available length even when it truncates output. */
+static inline size_t pdo_odbc_zos_output_length(int reported, size_t capacity)
+{
+	if (reported < 0 || capacity == 0) {
+		return 0;
+	}
+	return (size_t)reported < capacity ? (size_t)reported : capacity - 1;
+}
+
+#endif
diff --git a/ext/pdo_odbc/odbc_zos_params.h b/ext/pdo_odbc/odbc_zos_params.h
new file mode 100644
index 00000000..7a0f8d69
--- /dev/null
+++ b/ext/pdo_odbc/odbc_zos_params.h
@@ -0,0 +1,144 @@
+/* Native Db2 helpers. SQLLEN is signed 32-bit even in an LP64 application.
+ * No SDK declarations live here; callers supply the SQL types/constants. */
+#ifndef PDO_ODBC_ZOS_PARAMS_H
+#define PDO_ODBC_ZOS_PARAMS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define PDO_ODBC_ZOS_MAX_LEN ((size_t) INT32_MAX)
+#define PDO_ODBC_ZOS_PUT_CHUNK 8192
+
+static inline int pdo_odbc_zos_length(size_t length, SQLLEN *out)
+{
+	if (length > PDO_ODBC_ZOS_MAX_LEN) {
+		return 0;
+	}
+	*out = (SQLLEN) length;
+	return 1;
+}
+
+/* Capacity includes the terminator reserved for SQL_C_CHAR (or UCS-2).
+ * Keep it independent of the mutable StrLen_or_Ind value. */
+static inline int pdo_odbc_zos_capacity(size_t requested, int unicode,
+		size_t *payload, SQLLEN *capacity)
+{
+	size_t terminator = unicode ? 2 : 1;
+	size_t factor = unicode ? 2 : 1;
+	if (requested > (PDO_ODBC_ZOS_MAX_LEN - terminator) / factor) {
+		return 0;
+	}
+	*payload = requested * factor;
+	return pdo_odbc_zos_length(*payload + terminator, capacity);
+}
+
+static inline int pdo_odbc_zos_indicator(SQLLEN length, size_t capacity)
+{
+	return length == SQL_NULL_DATA ||
+		(length >= 0 && (size_t) length <= capacity);
+}
+
+/* A character name needs room for the terminator in the advertised buffer. */
+static inline int pdo_odbc_zos_name_length(SQLSMALLINT length, size_t capacity)
+{
+	return length >= 0 && (size_t) length < capacity;
+}
+
+static inline int pdo_odbc_zos_blob(SQLSMALLINT type)
+{
+#ifdef SQL_BLOB
+	/* Only a distinct native type may change the standard hex result contract. */
+	return type == SQL_BLOB && type != SQL_BINARY && type != SQL_VARBINARY &&
+		type != SQL_LONGVARBINARY;
+#else
+	(void) type;
+	return 0;
+#endif
+}
+
+static inline int pdo_odbc_zos_binary_input(SQLSMALLINT type)
+{
+	return type == SQL_BINARY || type == SQL_VARBINARY ||
+		type == SQL_LONGVARBINARY || pdo_odbc_zos_blob(type);
+}
+
+/* Validate SQLGetData's current chunk without inferring binary lengths from
+ * NUL bytes. SQL_NO_TOTAL is usable only for a full, truncated chunk. */
+static inline int pdo_odbc_zos_result_chunk(SQLLEN indicator, int truncated,
+		size_t payload, size_t used, size_t *amount)
+{
+	if (truncated) {
+		if (indicator != SQL_NO_TOTAL &&
+			(indicator < 0 || (size_t) indicator <= payload)) {
+			return 0;
+		}
+		*amount = payload;
+	} else {
+		if (indicator < 0 || (size_t) indicator > payload) {
+			return 0;
+		}
+		*amount = (size_t) indicator;
+	}
+	return used <= PDO_ODBC_ZOS_MAX_LEN && *amount <= PDO_ODBC_ZOS_MAX_LEN - used;
+}
+
+enum pdo_odbc_zos_transfer_result {
+	PDO_ODBC_ZOS_TRANSFER_OK,
+	PDO_ODBC_ZOS_TRANSFER_READ,
+	PDO_ODBC_ZOS_TRANSFER_PUT,
+	PDO_ODBC_ZOS_TRANSFER_LENGTH
+};
+
+typedef ptrdiff_t (*pdo_odbc_zos_read_fn)(void *, char *, size_t);
+typedef int (*pdo_odbc_zos_put_fn)(void *, const char *, SQLLEN);
+
+static inline enum pdo_odbc_zos_transfer_result pdo_odbc_zos_put_string(
+		const char *data, size_t length, pdo_odbc_zos_put_fn put, void *context)
+{
+	SQLLEN checked;
+	size_t offset = 0;
+	if (!pdo_odbc_zos_length(length, &checked)) {
+		return PDO_ODBC_ZOS_TRANSFER_LENGTH;
+	}
+	/* A zero-length value is not NULL: SQLPutData must still be called. */
+	do {
+		size_t amount = length - offset;
+		if (amount > PDO_ODBC_ZOS_PUT_CHUNK) {
+			amount = PDO_ODBC_ZOS_PUT_CHUNK;
+		}
+		if (!put(context, data + offset, (SQLLEN) amount)) {
+			return PDO_ODBC_ZOS_TRANSFER_PUT;
+		}
+		offset += amount;
+	} while (offset < length);
+	return PDO_ODBC_ZOS_TRANSFER_OK;
+}
+
+static inline enum pdo_odbc_zos_transfer_result pdo_odbc_zos_put_stream(
+		pdo_odbc_zos_read_fn read, void *stream,
+		pdo_odbc_zos_put_fn put, void *context)
+{
+	char buffer[PDO_ODBC_ZOS_PUT_CHUNK];
+	size_t total = 0;
+	for (;;) {
+		ptrdiff_t amount = read(stream, buffer, sizeof(buffer));
+		if (amount < 0 || (size_t) amount > sizeof(buffer)) {
+			return PDO_ODBC_ZOS_TRANSFER_READ;
+		}
+		if (amount == 0) {
+			if (total == 0 && !put(context, buffer, 0)) {
+				return PDO_ODBC_ZOS_TRANSFER_PUT;
+			}
+			return PDO_ODBC_ZOS_TRANSFER_OK;
+		}
+		if ((size_t) amount > PDO_ODBC_ZOS_MAX_LEN - total) {
+			return PDO_ODBC_ZOS_TRANSFER_LENGTH;
+		}
+		if (!put(context, buffer, (SQLLEN) amount)) {
+			return PDO_ODBC_ZOS_TRANSFER_PUT;
+		}
+		total += (size_t) amount;
+	}
+}
+
+#endif
