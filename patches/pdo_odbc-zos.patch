+
+/* Complete only missing top-level credentials, including explicitly supplied
+ * empty strings. Keep the shared ODBC quoting rules for the appended values. */
+static bool pdo_odbc_zos_complete_connstr(pdo_dbh_t *dbh)
+{
+	unsigned present = pdo_odbc_zos_credentials(dbh->data_source);
+	bool add_uid = dbh->username != NULL && !(present & PDO_ODBC_ZOS_UID);
+	bool add_pwd = dbh->password != NULL && !(present & PDO_ODBC_ZOS_PWD);
+	const char *values[2] = {add_uid ? dbh->username : NULL, add_pwd ? dbh->password : NULL};
+	char *quoted[2] = {NULL, NULL};
+	size_t length = strlen(dbh->data_source);
+	bool valid = pdo_odbc_zos_connstr_length_valid(length);
+
+	for (unsigned i = 0; valid && i < 2; i++) {
+		if (values[i] == NULL) {
+			continue;
+		}
+		/* Bound the raw value before asking the quoting helper to size it. */
+		if (!pdo_odbc_zos_connstr_length_valid(strlen(values[i]))) {
+			valid = false;
+			break;
+		}
+		if (!php_odbc_connstr_is_quoted(values[i]) && php_odbc_connstr_should_quote(values[i])) {
+			size_t size = php_odbc_connstr_estimate_quote_length(values[i]);
+			quoted[i] = emalloc(size);
+			php_odbc_connstr_quote(quoted[i], values[i], size);
+			values[i] = quoted[i];
+		}
+		valid = pdo_odbc_zos_append_length(&length, strlen(values[i]));
+	}
+	if (valid && (add_uid || add_pwd)) {
+		char *dsn = pemalloc(length + 1, dbh->is_persistent);
+		snprintf(dsn, length + 1, "%s%s%s%s%s", dbh->data_source,
+			add_uid ? ";UID=" : "", add_uid ? values[0] : "",
+			add_pwd ? ";PWD=" : "", add_pwd ? values[1] : "");
+		pefree((char *)dbh->data_source, dbh->is_persistent);
+		dbh->data_source = dsn;
+		dbh->data_source_len = length;
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		if (quoted[i]) {
+			efree(quoted[i]);
+		}
+	}
+	if (!valid) {
+		pdo_raise_impl_error(dbh, NULL, "HY090", "Native ODBC connection string exceeds INT16_MAX bytes");
+	}
+	return valid;
+}
+#else
+#define PDO_ODBC_STATE_SUCCEEDED(rc) ((rc) == SQL_SUCCESS)
+#endif
 
