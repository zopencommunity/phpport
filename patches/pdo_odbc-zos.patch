+#ifdef PDO_ODBC_DB2_ZOS
+static int pdo_odbc_zos_get_col(pdo_stmt_t *stmt, int colno, zval *result)
+{
+	pdo_odbc_stmt *S = stmt->driver_data;
+	pdo_odbc_column *C = &S->cols[colno];
+	if (!C->is_long) {
+		if (!pdo_odbc_zos_indicator(C->fetched_len, C->datalen)) {
+			pdo_raise_impl_error(stmt->dbh, stmt, "22001", "Native bound column truncated or invalid length returned");
+			return 0;
+		}
+		if (C->fetched_len == SQL_NULL_DATA) {
+			ZVAL_NULL(result);
+		} else {
+			ZVAL_STRINGL(result, C->data, (size_t) C->fetched_len);
+		}
+		return 1;
+	} else {
+		/* Distinct native BLOB is raw bytes, as in python-ibmdb. Standard
+		 * SQL_BINARY/VARBINARY retain the existing SQL_C_CHAR hex contract. */
+		int binary = C->is_unicode || pdo_odbc_zos_blob(C->coltype);
+		size_t payload = binary ? 256 : 255;
+		size_t used = 0;
+		int first = 1;
+		zend_string *str = zend_string_init("", 0, 0);
+		for (;;) {
+			size_t amount;
+			int truncated;
+			RETCODE rc;
+			C->fetched_len = SQL_NO_TOTAL;
+			/* Never retain bytes from a preceding, possibly longer chunk. */
+			memset(C->data, 0, 256);
+			rc = SQLGetData(S->stmt, colno+1, binary ? SQL_C_BINARY : SQL_C_CHAR,
+				C->data, 256, &C->fetched_len);
+			if (rc == SQL_NO_DATA && !first) {
+				break;
+			}
+			if (rc != SQL_SUCCESS && rc != SQL_SUCCESS_WITH_INFO) {
+				zend_string_release(str);
+				pdo_odbc_stmt_error("SQLGetData");
+				return 0;
+			}
+			if (C->fetched_len == SQL_NULL_DATA && first) {
+				zend_string_release(str);
+				ZVAL_NULL(result);
+				return 1;
+			}
+			truncated = rc == SQL_SUCCESS_WITH_INFO &&
+				(C->fetched_len == SQL_NO_TOTAL || C->fetched_len > (SQLLEN) payload);
+			if (!pdo_odbc_zos_result_chunk(C->fetched_len, truncated, payload, used, &amount)) {
+				zend_string_release(str);
+				pdo_raise_impl_error(stmt->dbh, stmt, "22001", "Native column length unknown, truncated or exceeds 32-bit limit");
+				return 0;
+			}
+			if (!binary && (C->data[amount] != '\0' ||
+				(truncated && memchr(C->data, '\0', amount) != NULL))) {
+				/* A short truncated character chunk may end at a character
+				 * boundary, or contain an embedded NUL. Neither its indicator
+				 * nor the first NUL proves how many payload bytes were written.
+				 * Final known-length text, however, may contain embedded NULs. */
+				zend_string_release(str);
+				pdo_raise_impl_error(stmt->dbh, stmt, "22001", "Native character chunk lacks termination or has ambiguous truncated length");
+				return 0;
+			}
+			str = zend_string_realloc(str, used + amount, 0);
+			memcpy(ZSTR_VAL(str) + used, C->data, amount);
+			used += amount;
+			first = 0;
+			if (!truncated) {
+				break;
+			}
+		}
+		ZSTR_VAL(str)[used] = '\0';
+		ZVAL_STR(result, str);
+		return 1;
+	}
+}
+#endif
