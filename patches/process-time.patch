diff --git a/ext/standard/basic_functions.c b/ext/standard/basic_functions.c
index b2282750..aab77c12 100755
--- a/ext/standard/basic_functions.c
+++ b/ext/standard/basic_functions.c
@@ -1179,6 +1179,18 @@ PHP_FUNCTION(usleep)
 		RETURN_THROWS();
 	}
 
+#if defined(__MVS__) && defined(HAVE_NANOSLEEP)
+	if (num >= 1000000) {
+		/* Native usleep() rejects delays of one second or more. Normalize
+		 * without truncating to unsigned int, and allow signal interruption
+		 * just as usleep() does (do not restart on EINTR). */
+		struct timespec req;
+		req.tv_sec = (time_t) (num / 1000000);
+		req.tv_nsec = (long) (num % 1000000) * 1000;
+		nanosleep(&req, NULL);
+		return;
+	}
+#endif
 #ifdef HAVE_USLEEP
 	usleep((unsigned int)num);
 #endif
diff --git a/ext/standard/proc_open.c b/ext/standard/proc_open.c
index 03c0063a..83e818a5 100644
--- a/ext/standard/proc_open.c
+++ b/ext/standard/proc_open.c
@@ -1269,11 +1269,38 @@ PHP_FUNCTION(proc_open)
 		}
 
 		if (argv) {
+#ifdef __MVS__
+			/* Assigning environ does not update the z/OS bimodal environment.
+			 * Pass envp explicitly, including an intentionally empty array. */
+			if (env.envarray) {
+				if (strchr(ZSTR_VAL(command_str), '/')) {
+					execve(ZSTR_VAL(command_str), argv, env.envarray);
+				} else {
+					/* execvpe searches the calling environment's PATH. Match
+					 * execvp-after-environ-assignment semantics in this child,
+					 * without leaking the parent's search path into an empty env. */
+					const char *search_path = NULL;
+					for (char **entry = env.envarray; *entry; entry++) {
+						if (strncmp(*entry, "PATH=", 5) == 0) {
+							search_path = *entry + 5;
+							break;
+						}
+					}
+					int result = search_path ? setenv("PATH", search_path, 1) : unsetenv("PATH");
+					if (result == 0) {
+						execvpe(ZSTR_VAL(command_str), argv, env.envarray);
+					}
+				}
+			} else {
+				execvp(ZSTR_VAL(command_str), argv);
+			}
+#else
 			/* execvpe() is non-portable, use environ instead. */
 			if (env.envarray) {
 				environ = env.envarray;
 			}
 			execvp(ZSTR_VAL(command_str), argv);
+#endif
 		} else {
 			if (env.envarray) {
 				execle("/bin/sh", "sh", "-c", ZSTR_VAL(command_str), NULL, env.envarray);
diff --git a/ext/standard/tests/general_functions/proc_open_array_env.phpt b/ext/standard/tests/general_functions/proc_open_array_env.phpt
new file mode 100644
index 00000000..e8a66754
--- /dev/null
+++ b/ext/standard/tests/general_functions/proc_open_array_env.phpt
@@ -0,0 +1,51 @@
+--TEST--
+z/OS proc_open() command arrays preserve child PATH and distinguish inherited and empty environments
+--SKIPIF--
+<?php
+if (PHP_OS !== 'OS/390') die('skip native z/OS environment handling');
+?>
+--FILE--
+<?php
+$php = getenv('TEST_PHP_EXECUTABLE');
+putenv('PHP_PROC_OPEN_PARENT=parent');
+putenv('PHP_PROC_OPEN_CHILD');
+putenv('PHP_PROC_OPEN_EXPECTED_PATH');
+putenv('PATH=' . dirname($php));
+$searchPath = __DIR__ . '/no-such-path' . PATH_SEPARATOR . dirname($php);
+$code = 'var_dump(getenv("PHP_PROC_OPEN_PARENT"), getenv("PHP_PROC_OPEN_CHILD"));'
+    . 'if (getenv("PHP_PROC_OPEN_EXPECTED_PATH") !== false)'
+    . 'var_dump(getenv("PATH") === getenv("PHP_PROC_OPEN_EXPECTED_PATH"));';
+$spec = [0 => ['null'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
+
+foreach ([
+    'Inherited' => null,
+    'Explicit' => ['PATH' => $searchPath, 'PHP_PROC_OPEN_CHILD' => 'child',
+        'PHP_PROC_OPEN_EXPECTED_PATH' => $searchPath],
+    'Empty' => [],
+] as $label => $env) {
+    echo "$label:\n";
+    // The explicit child's PATH must work even when the parent cannot find PHP.
+    putenv('PATH=' . ($label === 'Explicit' ? __DIR__ . '/no-such-path' : dirname($php)));
+    $command = [$label === 'Explicit' ? basename($php) : $php, '-n', '-r', $code];
+    $proc = proc_open($command, $spec, $pipes, null, $env);
+    echo stream_get_contents($pipes[1]);
+    echo stream_get_contents($pipes[2]);
+    fclose($pipes[1]);
+    fclose($pipes[2]);
+    var_dump(proc_close($proc));
+}
+?>
+--EXPECT--
+Inherited:
+string(6) "parent"
+bool(false)
+int(0)
+Explicit:
+bool(false)
+string(5) "child"
+bool(true)
+int(0)
+Empty:
+bool(false)
+bool(false)
+int(0)
diff --git a/ext/standard/tests/general_functions/proc_open_array_env_path.phpt b/ext/standard/tests/general_functions/proc_open_array_env_path.phpt
new file mode 100644
index 00000000..72a33e6e
--- /dev/null
+++ b/ext/standard/tests/general_functions/proc_open_array_env_path.phpt
@@ -0,0 +1,25 @@
+--TEST--
+z/OS proc_open() explicit PATH must not fall back to the parent PATH
+--SKIPIF--
+<?php
+if (PHP_OS !== 'OS/390') die('skip native z/OS child exec status');
+?>
+--FILE--
+<?php
+$php = getenv('TEST_PHP_EXECUTABLE');
+putenv('PATH=' . dirname($php));
+$spec = [0 => ['null'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
+$proc = proc_open([basename($php), '-n', '-r', 'echo "wrong executable path";'],
+    $spec, $pipes, null, ['PATH' => __DIR__ . '/no-such-path']);
+// Runtime diagnostics follow display_errors and may use either pipe.
+$output = stream_get_contents($pipes[1]) . stream_get_contents($pipes[2]);
+var_dump(!str_contains($output, 'wrong executable path'));
+var_dump(str_contains($output, 'Exec failed'));
+fclose($pipes[1]);
+fclose($pipes[2]);
+var_dump(proc_close($proc));
+?>
+--EXPECT--
+bool(true)
+bool(true)
+int(127)
diff --git a/ext/standard/tests/general_functions/usleep_interrupt.phpt b/ext/standard/tests/general_functions/usleep_interrupt.phpt
new file mode 100644
index 00000000..4d1b7af2
--- /dev/null
+++ b/ext/standard/tests/general_functions/usleep_interrupt.phpt
@@ -0,0 +1,26 @@
+--TEST--
+usleep() with a multi-second delay can be interrupted by a signal
+--EXTENSIONS--
+pcntl
+--SKIPIF--
+<?php
+if (getenv('SKIP_SLOW_TESTS')) die('skip slow test');
+?>
+--FILE--
+<?php
+$handled = false;
+pcntl_async_signals(true);
+pcntl_signal(SIGALRM, function () use (&$handled) {
+    $handled = true;
+});
+$start = microtime(true);
+pcntl_alarm(1);
+$result = usleep(3000000);
+$elapsed = microtime(true) - $start;
+pcntl_alarm(0);
+var_dump($result, $handled, $elapsed >= 0.98 && $elapsed < 2.9);
+?>
+--EXPECT--
+NULL
+bool(true)
+bool(true)
diff --git a/ext/standard/tests/general_functions/usleep_seconds.phpt b/ext/standard/tests/general_functions/usleep_seconds.phpt
new file mode 100644
index 00000000..12eec428
--- /dev/null
+++ b/ext/standard/tests/general_functions/usleep_seconds.phpt
@@ -0,0 +1,24 @@
+--TEST--
+usleep() accepts whole seconds and normalizes fractional seconds
+--SKIPIF--
+<?php
+if (getenv('SKIP_SLOW_TESTS')) die('skip slow test');
+?>
+--FILE--
+<?php
+var_dump(usleep(0));
+foreach ([1000000, 1250000] as $microseconds) {
+    $start = microtime(true);
+    $result = usleep($microseconds);
+    $elapsed = (microtime(true) - $start) * 1000000;
+    var_dump($result);
+    // Use the same minimum duration as usleep_basic.phpt.
+    var_dump($elapsed >= $microseconds * 0.98);
+}
+?>
+--EXPECT--
+NULL
+NULL
+bool(true)
+NULL
+bool(true)
